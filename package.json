{
  "name": "frameforge",
  "productName": "FrameForge",
  "version": "0.1.0",
  "description": "FrameForge — the measurement-driven FPS optimizer for Windows. Tune. Measure. Prove.",
  "main": "electron/main.js",
  "author": "FrameForge",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test:engine": "powershell -NoProfile -ExecutionPolicy Bypass -File engine/test/run-tests.ps1",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File build/dist.ps1",
    "dist:dir": "electron-builder --config electron-builder.config.js --win --x64 --dir"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
